{
  "name": "brickset-lego",
  "version": "0.9.1",
  "homepage": "https://github.com/mirkostanic/obsidian-lego#readme",
  "description": "Obsidian plugin to fetch LEGO set information from Brickset API",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirkostanic/obsidian-lego.git"
  },
  "bugs": {
    "url": "https://github.com/mirkostanic/obsidian-lego/issues"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "lego",
    "brickset"
  ],
  "author": "Mirko Stanić",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@eslint/json": "0.14.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "0.25.0",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.0.18"
  }
}
